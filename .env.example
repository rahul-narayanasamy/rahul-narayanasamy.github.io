# Local dev only. For GitHub Pages, set the same names under:
# Repo Settings → Secrets and variables → Actions → Variables

# Google Analytics 4 — Admin → Data streams → Measurement ID
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Microsoft Clarity — https://clarity.microsoft.com → Settings → Overview → Project ID
# Records clicks, scroll heatmaps, and session replays (free)
VITE_CLARITY_PROJECT_ID=
